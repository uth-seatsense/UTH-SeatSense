# =============================================================================
# UTH-SeatSense Environment Configuration
# =============================================================================
# File này là mẫu cho file .env thực tế. Copy file này thành .env và điền
# giá trị phù hợp với môi trường phát triển của bạn.
#
# KHÔNG commit file .env lên Git (đã có trong .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Cấu hình cơ sở dữ liệu PostgreSQL cho môi trường phát triển

# Tên database - không cần đổi trừ khi conflict với DB khác trên máy
POSTGRES_DB=seatsense

# Username để kết nối database - không cần đổi cho môi trường dev
POSTGRES_USER=seatsense

# MẬT KHẨU DATABASE - PHẢI THAY ĐỔI!
# ⚠️  Đây là biến BẮT BUỘC phải điền, nếu không Docker sẽ báo lỗi
# ⚠️  Dùng mật khẩu mạnh gồm chữ và số (tránh ký tự đặc biệt như @, #, $ để tránh lỗi)
# ⚠️  Đây chỉ là mật khẩu phát triển cục bộ, KHÔNG dùng cho production
# Ví dụ: dev123456, local2024, postgres123
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Port để truy cập PostgreSQL từ máy host
# Mặc định: 5432 (port chuẩn của PostgreSQL)
# Đổi thành 5433 nếu máy đã có PostgreSQL khác chạy ở port 5432
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend Service Configuration
# -----------------------------------------------------------------------------
# Cấu hình cho FastAPI backend service

# Port để truy cập Backend API từ browser/postman
# Mặc định: 8000
# URL: http://localhost:8000/docs (Swagger UI)
# Đổi thành 8001, 8002... nếu port 8000 đã bị dùng
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# CV Service Configuration
# -----------------------------------------------------------------------------
# Cấu hình cho Computer Vision service (YOLOv8 + ByteTrack)

# Port để truy cập CV API
# Mặc định: 8001
# URL: http://localhost:8001/docs
# Đổi nếu conflict với service khác
CV_PORT=8001

# -----------------------------------------------------------------------------
# Frontend Service Configuration
# -----------------------------------------------------------------------------
# Cấu hình cho React/Vite frontend

# Port để truy cập web UI
# Mặc định: 3000 (port chuẩn của React dev server)
# URL: http://localhost:3000
# Đổi thành 3001, 3002... nếu port 3000 đã bị dùng (ví dụ: đang chạy React app khác)
FRONTEND_PORT=3000

# Base URL path cho API calls từ frontend
# Frontend sẽ gọi API tại: http://localhost:3000/api/v1/*
# Vite proxy sẽ forward requests này tới backend
# ⚠️  KHÔNG thay đổi giá trị này trừ khi biết rõ đang làm gì
VITE_API_BASE_URL=/api/v1

# Backend service URL trong Docker internal network
# Frontend container dùng URL này để forward API requests tới backend
# Hostname "backend" là tên service trong docker-compose.yml
# ⚠️  KHÔNG thay đổi giá trị này - đây là internal Docker network name
VITE_BACKEND_PROXY_TARGET=http://backend:8000

# -----------------------------------------------------------------------------
# Adminer Configuration (Database Management Tool)
# -----------------------------------------------------------------------------
# Adminer là web UI để quản lý PostgreSQL (chỉ dùng cho development)

# Port để truy cập Adminer
# URL: http://localhost:8080
# Login credentials: dùng POSTGRES_USER và POSTGRES_PASSWORD ở trên
ADMINER_PORT=8080

# =============================================================================
# Hướng dẫn sử dụng
# =============================================================================
#
# 1. Copy file này:
#    Windows PowerShell:  Copy-Item .env.example .env
#    macOS/Linux:         cp .env.example .env
#
# 2. Mở file .env và thay đổi POSTGRES_PASSWORD (bắt buộc)
#
# 3. Đổi các PORT nếu bị conflict với service khác đang chạy trên máy
#
# 4. Khởi động Docker Compose:
#    docker compose up -d --build
#
# 5. Kiểm tra services đã chạy:
#    docker compose ps
#
# 6. Truy cập:
#    - Frontend: http://localhost:3000
#    - Backend API: http://localhost:8000/docs
#    - CV API: http://localhost:8001/docs
#    - Adminer: http://localhost:8080
#      Server: db
#      Username: seatsense (hoặc giá trị POSTGRES_USER)
#      Password: <giá trị POSTGRES_PASSWORD của bạn>
#      Database: seatsense (hoặc giá trị POSTGRES_DB)
#
# =============================================================================
# Bảo mật
# =============================================================================
#
# ⚠️  TUYỆT ĐỐI KHÔNG:
#    - Commit file .env lên GitHub
#    - Chia sẻ file .env qua email/chat
#    - Đưa mật khẩu production vào file này
#    - Chứa API keys, tokens, hoặc credentials thật trong file này
#
# ✅  NÊN:
#    - Chỉ dùng mật khẩu phát triển cục bộ
#    - Khi thêm biến mới, cập nhật .env.example (không chứa giá trị thật)
#    - Thông báo team qua Jira/Slack khi thêm biến mới
#
# =============================================================================
