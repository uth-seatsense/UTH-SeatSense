# Sao chép file này thành .env tại thư mục gốc trước khi chạy Docker Compose.
# Các giá trị bên dưới dành cho môi trường phát triển; không dùng mật khẩu mẫu
# cho máy chủ dùng chung hoặc môi trường triển khai.

# PostgreSQL: Compose truyền DB, user và password cho cả PostgreSQL lẫn backend.
POSTGRES_DB=seatsense
POSTGRES_USER=seatsense
# Bắt buộc phải đổi thành mật khẩu riêng. Không commit file .env thật lên Git.
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Cổng trên máy của bạn -> cổng bên trong container.
# Nếu cổng bên trái đã được ứng dụng khác sử dụng, hãy đổi giá trị tương ứng.
POSTGRES_PORT=5432
BACKEND_PORT=8000
CV_PORT=8001
FRONTEND_PORT=3000

# Thời gian chờ (phút) trước khi quy trình no-show được phép xử lý booking
# chưa check-in. Phải lớn hơn 0 và tối đa 1440. Giá trị 15 là mặc định tạm
# thời; cần chốt theo quy định thư viện. Cấu hình đã được nạp ở backend; tác
# vụ tự động đánh dấu no_show cần được triển khai riêng.
NO_SHOW_WAIT_MINUTES=15

# Frontend gọi API qua đường dẫn tương đối trên cùng origin.
# VITE_API_BASE_URL thường giữ /api/v1; Vite chuyển tiếp /api tới backend.
VITE_API_BASE_URL=/api/v1
# Địa chỉ backend mà tiến trình Vite truy cập được. Trong Docker dùng tên service
# backend; khi chạy frontend trực tiếp trên máy, thường đổi thành http://localhost:8000.
VITE_BACKEND_PROXY_TARGET=http://backend:8000
